        function loadOwnerData() {
            // Load current settings
            document.getElementById('owner-restaurant-name').value = config.restaurantName;
            document.getElementById('owner-whatsapp').value = config.whatsappNumber;
            
            // Load employee list
            const employeeList = document.getElementById('employee-list');
            employeeList.innerHTML = '';
            
            Object.keys(managementData.users).forEach(username => {
                const user = managementData.users[username];
                if (user.role !== 'owner') {
                    const div = document.createElement('div');
                    div.className = 'flex justify-between items-center bg-white p-3 rounded-lg';
                    
                    const roleNames = {
                        'manager': '👨‍💼 Encargado',
                        'cashier': '💰 Cajero',
                        'cook': '👨‍🍳 Cocinero',
                        'waiter': '🍽️ Mesero'
                    };
                    
                    div.innerHTML = `
                        <div>
                            <div class="font-semibold">${user.name}</div>
                            <div class="text-sm text-gray-600">Usuario: ${username} • Rol: ${roleNames[user.role] || 'Empleado'}</div>
                        </div>
                        <button onclick="removeEmployee('${username}')" class="bg-red-500 hover:bg-red-600 text-white px-3 py-1 rounded text-sm">
                            Eliminar
                        </button>
                    `;
                    employeeList.appendChild(div);
                }
            });
            
            if (employeeList.innerHTML === '') {
                employeeList.innerHTML = '<p class="text-gray-500 text-center py-4">No hay empleados registrados</p>';
            }
            
            // Load financial overview
            let totalSales = managementData.dailyStats.sales;
            let totalExpenses = managementData.expenses.reduce((sum, expense) => sum + expense.amount, 0);
            let totalOrders = managementData.dailyStats.orders;
            
            document.getElementById('owner-total-sales').textContent = `$${totalSales}`;
            document.getElementById('owner-total-expenses').textContent = `$${totalExpenses}`;
            document.getElementById('owner-total-orders').textContent = totalOrders;
            document.getElementById('owner-net-profit').textContent = `$${totalSales - totalExpenses}`;
