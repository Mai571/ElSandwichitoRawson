<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>El Sandwichito Rawson - Menú</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap');
        body { 
            font-family: 'Poppins', sans-serif; 
            background: linear-gradient(-45deg, #ff6b6b, #4ecdc4, #45b7d1, #96ceb4, #feca57, #ff9ff3, #54a0ff);
            background-size: 400% 400%;
            animation: gradientShift 15s ease infinite;
        }
        
        @keyframes gradientShift {
            0% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
            100% { background-position: 0% 50%; }
        }
        
        .gradient-bg { 
            background: linear-gradient(135deg, #ff6b6b, #ffa500, #ff4757, #ff3838, #ff6348); 
            background-size: 300% 300%;
            animation: headerGradient 8s ease infinite;
            position: relative;
            overflow: hidden;
        }
        
        .gradient-bg::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.3), transparent);
            animation: shine 3s infinite;
        }
        
        @keyframes headerGradient {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        
        @keyframes shine {
            0% { left: -100%; }
            100% { left: 100%; }
        }
        
        .category-card {
            background: linear-gradient(135deg, #ffd700 0%, #ffb347 100%);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
        }
        
        .category-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, #ff8c00 0%, #ff6347 50%, #ff4500 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .category-card:hover {
            transform: translateY(-8px) scale(1.05);
            box-shadow: 0 20px 40px rgba(255,140,0,0.4);
        }
        
        .category-card:hover::before {
            opacity: 1;
        }
        
        .category-card > div {
            position: relative;
            z-index: 1;
        }
        
        .product-card {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            position: relative;
            overflow: hidden;
        }
        
        .product-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: linear-gradient(135deg, #ff8c00 0%, #ff6347 50%, #ff4500 100%);
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .product-card:hover {
            transform: translateY(-10px) scale(1.08) rotate(2deg);
            box-shadow: 0 25px 50px rgba(255,140,0,0.5);
        }
        
        .product-card:hover::before {
            opacity: 1;
        }
        
        .product-card > div {
            position: relative;
            z-index: 1;
        }
        
        .cart-bounce { 
            animation: bounce 0.5s ease-in-out, rainbow 2s linear infinite; 
        }
        
        @keyframes bounce {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.2) rotate(10deg); }
        }
        
        @keyframes rainbow {
            0% { background: #ff6b6b; }
            16% { background: #ffa500; }
            32% { background: #4ecdc4; }
            48% { background: #45b7d1; }
            64% { background: #96ceb4; }
            80% { background: #ff9ff3; }
            100% { background: #ff6b6b; }
        }
        
        .pulse-button {
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0% { box-shadow: 0 0 0 0 rgba(255, 107, 107, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(255, 107, 107, 0); }
            100% { box-shadow: 0 0 0 0 rgba(255, 107, 107, 0); }
        }
        
        .wiggle {
            animation: wiggle 3s ease-in-out infinite;
        }
        
        @keyframes wiggle {
            0%, 90% { transform: rotateZ(0); }
            95% { transform: rotateZ(-2deg); }
            100% { transform: rotateZ(0); }
        }
        
        .glow {
            box-shadow: 0 0 20px rgba(255, 107, 107, 0.6);
            animation: glow 2s ease-in-out infinite alternate;
        }
        
        @keyframes glow {
            from { box-shadow: 0 0 20px rgba(255, 107, 107, 0.6); }
            to { box-shadow: 0 0 30px rgba(255, 107, 107, 0.8), 0 0 40px rgba(255, 107, 107, 0.6); }
        }
        
        .modal-enter {
            animation: modalEnter 0.3s ease-out;
        }
        
        @keyframes modalEnter {
            from { opacity: 0; transform: scale(0.8) translateY(-50px); }
            to { opacity: 1; transform: scale(1) translateY(0); }
        }
        
        .text-gradient {
            background: linear-gradient(45deg, #ff6b6b, #4ecdc4, #45b7d1, #96ceb4);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: textShine 3s ease-in-out infinite;
        }
        
        @keyframes textShine {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        .admin-panel { max-height: 80vh; overflow-y: auto; }
        
        .status-indicator {
            width: 12px;
            height: 12px;
            border-radius: 50%;
            display: inline-block;
            margin-right: 8px;
        }
        
        .status-open { background-color: #10b981; }
        .status-closed { background-color: #ef4444; }
        
        .transaction-item {
            border-left: 4px solid #3b82f6;
            transition: all 0.3s ease;
        }
        
        .transaction-item:hover {
            background-color: #f8fafc;
            transform: translateX(4px);
        }
        
        .expense-item {
            border-left: 4px solid #ef4444;
        }
        
        .income-item {
            border-left: 4px solid #10b981;
        }
    </style>
</head>
<body class="bg-gradient-to-br from-orange-50 to-red-50 min-h-screen">
    <!-- Management Login Button -->
    <button onclick="showManagementLogin()" class="fixed top-4 left-4 bg-blue-600 hover:bg-blue-700 text-white p-3 rounded-full text-lg z-40 transition-all hover:scale-110">
        💼
    </button>

    <!-- Store Status Indicator -->
    <div id="store-status" class="fixed top-4 right-4 bg-white rounded-lg px-4 py-2 shadow-lg z-40">
        <div class="flex items-center">
            <span id="status-indicator" class="status-indicator status-open"></span>
            <span id="status-text" class="text-sm font-medium">Abierto</span>
        </div>
    </div>

    <!-- Header -->
    <header class="gradient-bg text-white py-6 px-4 shadow-lg">
        <div class="max-w-6xl mx-auto text-center">
            <h1 id="restaurant-name" class="text-4xl font-bold mb-2 wiggle"><span id="restaurant-logo-before">🥪</span> El Sandwichito Rawson <span id="restaurant-logo-after">🥪</span></h1>
            <p id="restaurant-slogan" class="text-xl font-medium text-black">Sabores auténticos que conquistan</p>
        </div>
    </header>

    <!-- Main Content -->
    <div class="max-w-6xl mx-auto p-4">
        <!-- Categories -->
        <div id="categories" class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
            <!-- Categories will be rendered here -->
        </div>

        <!-- Products Section -->
        <div id="products-section" class="hidden">
            <div class="flex items-center justify-between mb-6">
                <h2 id="category-title" class="text-3xl font-bold text-gray-800"></h2>
                <button onclick="showCategories()" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded-lg transition-colors">
                    ← Volver
                </button>
            </div>
            <div id="products-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6"></div>
        </div>
    </div>

    <!-- Cart Button -->
    <div id="cart-button" class="fixed bottom-4 right-4 bg-red-500 hover:bg-red-600 text-white rounded-full p-4 shadow-lg cursor-pointer transition-all pulse-button" onclick="toggleCart()">
        <div class="flex items-center">
            <span class="text-2xl mr-2">🛒</span>
            <span id="cart-count" class="bg-white text-red-500 rounded-full px-2 py-1 text-sm font-bold">0</span>
        </div>
    </div>

    <!-- Management Login Modal -->
    <div id="management-login-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="bg-white rounded-xl max-w-md w-full">
                <div class="p-6">
                    <h3 class="text-2xl font-bold text-gray-800 mb-6">Acceso al Sistema</h3>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Usuario</label>
                            <input type="text" id="management-username" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-gray-700 mb-1">Contraseña</label>
                            <div class="relative">
                                <input type="password" id="management-password" class="w-full border border-gray-300 rounded-lg px-3 py-2 pr-10 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                <button type="button" onclick="toggleManagementPasswordVisibility()" class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 hover:text-gray-600">
                                    <span id="management-password-toggle-icon">🙈</span>
                                </button>
                            </div>
                        </div>
                        <div id="management-login-error" class="text-red-500 text-sm hidden">Usuario o contraseña incorrectos</div>
                    </div>
                    <div class="flex space-x-3 mt-6">
                        <button onclick="closeManagementLogin()" class="flex-1 bg-gray-500 hover:bg-gray-600 text-white py-3 rounded-lg font-semibold transition-colors">
                            Cancelar
                        </button>
                        <button onclick="managementLogin()" class="flex-1 bg-blue-500 hover:bg-blue-600 text-white py-3 rounded-lg font-semibold transition-colors">
                            Ingresar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Management Panel Modal -->
    <div id="management-panel-modal" class="fixed inset-0 bg-black bg-opacity-50 hidden z-50">
        <div class="flex items-center justify-center min-h-screen p-4">
            <div class="bg-white rounded-xl max-w-6xl w-full admin-panel">
                <div class="p-6">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h3 class="text-2xl font-bold text-gray-800">Panel de Gestión</h3>
                            <p class="text-sm text-gray-600">Bienvenido/a, <span id="current-user-name"></span> (<span id="current-user-role"></span>)</p>
                        </div>
                        <button onclick="closeManagementPanel()" class="text-gray-500 hover:text-gray-700 text-2xl">×</button>
                    </div>

                    <!-- Management Tabs -->
                    <div class="flex space-x-4 mb-6 border-b overflow-x-auto">
                        <button onclick="showManagementTab('operations')" class="management-tab px-4 py-2 font-semibold border-b-2 border-blue-500 text-blue-500 whitespace-nowrap">Operaciones</button>
                        <button onclick="showManagementTab('cash')" class="management-tab px-4 py-2 font-semibold text-gray-500 hover:text-blue-500 whitespace-nowrap">Caja</button>
                        <button onclick="showManagementTab('expenses')" class="management-tab px-4 py-2 font-semibold text-gray-500 hover:text-blue-500 whitespace-nowrap">Gastos</button>
                        <button id="reports-tab" onclick="showManagementTab('reports')" class="management-tab px-4 py-2 font-semibold text-gray-500 hover:text-blue-500 whitespace-nowrap hidden">Reportes</button>
                        <button id="owner-tab" onclick="showManagementTab('owner')" class="management-tab px-4 py-2 font-semibold text-gray-500 hover:text-blue-500 whitespace-nowrap hidden">Dueño</button>
                    </div>

                    <!-- Operations Tab -->
                    <div id="management-operations" class="management-tab-content">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Store Status -->
                            <div class="bg-gray-50 rounded-lg p-6">
                                <h4 class="text-lg font-semibold mb-4 flex items-center">
                                    🏪 Estado del Local
                                </h4>
                                <div class="space-y-4">
                                    <div class="flex items-center justify-between">
                                        <span>Estado actual:</span>
                                        <div class="flex items-center">
                                            <span id="current-store-status" class="status-indicator status-open"></span>
                                            <span id="current-store-text">Abierto</span>
                                        </div>
                                    </div>
                                    <div class="flex space-x-2">
                                        <button onclick="toggleStoreStatus()" id="toggle-store-btn" class="flex-1 bg-red-500 hover:bg-red-600 text-white py-2 rounded-lg font-semibold transition-colors">
                                            Cerrar Local
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Quick Actions -->
                            <div class="bg-gray-50 rounded-lg p-6">
                                <h4 class="text-lg font-semibold mb-4 flex items-center">
                                    ⚡ Acciones Rápidas
                                </h4>
                                <div class="space-y-2">
                                    <button onclick="showQuickExpense()" class="w-full bg-orange-500 hover:bg-orange-600 text-white py-2 rounded-lg font-semibold transition-colors">
                                        💸 Registrar Gasto Rápido
                                    </button>
                                    <button onclick="showCashCount()" class="w-full bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg font-semibold transition-colors">
                                        💰 Contar Caja
                                    </button>
                                    <button onclick="generateDailyReport()" class="w-full bg-blue-500 hover:bg-blue-600 text-white py-2 rounded-lg font-semibold transition-colors">
                                        📊 Reporte del Día
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Today's Summary (Owner Only) -->
                        <div id="today-summary" class="mt-6 bg-gray-50 rounded-lg p-6 hidden">
                            <h4 class="text-lg font-semibold mb-4">📈 Resumen de Hoy</h4>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-green-600" id="today-sales">$0</div>
                                    <div class="text-sm text-gray-600">Ventas</div>
                                </div>
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-red-600" id="today-expenses">$0</div>
                                    <div class="text-sm text-gray-600">Gastos</div>
                                </div>
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-blue-600" id="today-orders">0</div>
                                    <div class="text-sm text-gray-600">Pedidos</div>
                                </div>
                                <div class="text-center">
                                    <div class="text-2xl font-bold text-purple-600" id="today-profit">$0</div>
                                    <div class="text-sm text-gray-600">Ganancia</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Cash Tab -->
                    <div id="management-cash" class="management-tab-content hidden">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <!-- Cash Operations -->
                            <div class="space-y-6">
                                <div class="bg-gray-50 rounded-lg p-6">
                                    <h4 class="text-lg font-semibold mb-4">💰 Operaciones de Caja</h4>
                                    <div class="space-y-4">
                                        <div class="flex items-center justify-between">
                                            <span>Estado de caja:</span>
                                            <div class="flex items-center">
                                                <span id="cash-status-indicator" class="status-indicator status-closed"></span>
                                                <span id="cash-status-text">Cerrada</span>
                                            </div>
                                        </div>
                                        <div class="flex space-x-2">
                                            <button onclick="openCash()" id="open-cash-btn" class="flex-1 bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg font-semibold transition-colors">
                                                Abrir Caja
                                            </button>
                                            <button onclick="closeCash()" id="close-cash-btn" class="flex-1 bg-red-500 hover:bg-red-600 text-white py-2 rounded-lg font-semibold transition-colors disabled:opacity-50" disabled>
                                                Cerrar Caja
                                            </button>
                                        </div>
                                    </div>
                                </div>

                                <div class="bg-gray-50 rounded-lg p-6">
                                    <h4 class="text-lg font-semibold mb-4">💵 Movimientos de Efectivo</h4>
                                    <div class="space-y-3">
                                        <button onclick="showCashMovement('in')" class="w-full bg-green-500 hover:bg-green-600 text-white py-2 rounded-lg font-semibold transition-colors">
                                            ➕ Ingreso de Efectivo
                                        </button>
                                        <button onclick="showCashMovement('out')" class="w-full bg-red-500 hover:bg-red-600 text-white py-2 rounded-lg font-semibold transition-colors">
                                            ➖ Egreso de Efectivo
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Cash Status -->
                            <div class="bg-gray-50 rounded-lg p-6">
                                <h4 class="text-lg font-semibold mb-4">📊 Estado Actual de Caja</h4>
                                <div class="space-y-4">
                                    <div class="flex justify-between items-center">
                                        <span>Apertura:</span>
                                        <span class="font-semibold" id="cash-opening">$0</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span>Ventas del día:</span>
                                        <span class="font-semibold text-green-600" id="cash-sales">$0</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span>Gastos del día:</span>
                                        <span class="font-semibold text-red-600" id="cash-expenses">$0</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span>Otros ingresos:</span>
                                        <span class="font-semibold text-blue-600" id="cash-other-income">$0</span>
                                    </div>
                                    <div class="flex justify-between items-center">
                                        <span>Otros egresos:</span>
                                        <span class="font-semibold text-orange-600" id="cash-other-expenses">$0</span>
                                    </div>
                                    <hr>
                                    <div class="flex justify-between items-center text-lg font-bold">
                                        <span>Total esperado:</span>
                                        <span id="cash-expected">$0</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Expenses Tab -->
                    <div id="management-expenses" class="management-tab-content hidden">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <!-- Add Expense -->
                            <div class="bg-gray-50 rounded-lg p-6">
                                <h4 class="text-lg font-semibold mb-4">💸 Registrar Gasto</h4>
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Categoría</label>
                                        <select id="expense-category" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                            <option value="sueldos">💼 Sueldos</option>
                                            <option value="insumos">📦 Insumos</option>
                                            <option value="servicios">⚡ Servicios</option>
                                            <option value="mantenimiento">🔧 Mantenimiento</option>
                                            <option value="marketing">📢 Marketing</option>
                                            <option value="otros">📋 Otros</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Descripción</label>
                                        <input type="text" id="expense-description" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="Ej: Pago de sueldo Juan">
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Monto</label>
                                        <input type="number" id="expense-amount" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500" placeholder="0">
                                    </div>
                                    <button onclick="addExpense()" class="w-full bg-red-500 hover:bg-red-600 text-white py-2 rounded-lg font-semibold transition-colors">
                                        Registrar Gasto
                                    </button>
                                </div>
                            </div>

                            <!-- Expense Categories Summary -->
                            <div class="bg-gray-50 rounded-lg p-6">
                                <h4 class="text-lg font-semibold mb-4">📊 Gastos por Categoría (Hoy)</h4>
                                <div id="expense-categories-summary" class="space-y-3">
                                    <!-- Will be populated dynamically -->
                                </div>
                            </div>
                        </div>

                        <!-- Recent Expenses -->
                        <div class="mt-6 bg-gray-50 rounded-lg p-6">
                            <h4 class="text-lg font-semibold mb-4">📋 Gastos Recientes</h4>
                            <div id="recent-expenses" class="space-y-2 max-h-60 overflow-y-auto">
                                <!-- Will be populated dynamically -->
                            </div>
                        </div>
                    </div>

                    <!-- Reports Tab -->
                    <div id="management-reports" class="management-tab-content hidden">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <!-- Report Generator -->
                            <div class="bg-gray-50 rounded-lg p-6">
                                <h4 class="text-lg font-semibold mb-4">📊 Generar Reportes</h4>
                                <div class="space-y-4">
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Tipo de Reporte</label>
                                        <select id="report-type" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                            <option value="daily">📅 Reporte Diario</option>
                                            <option value="weekly">📆 Reporte Semanal</option>
                                            <option value="monthly">🗓️ Reporte Mensual</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-sm font-medium text-gray-700 mb-1">Fecha</label>
                                        <input type="date" id="report-date" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-500">
                                    </div>
                                    <button onclick="generateReport()" class="w-full bg-blue-500 hover:bg-blue-600 text-white py-2 rounded-lg font-semibold transition-colors">
                                        Generar Reporte
                                    </button>
                                </div>
                            </div>

                            <!-- Quick Stats -->
                            <div class="bg-gray-50 rounded-lg p-6">
                                <h4 class="text-lg font-semibold mb-4">⚡ Estadísticas Rápidas</h4>
                                <div class="space-y-3">
                                    <div class="flex justify-between">
                                        <span>Ventas esta semana:</span>
                                        <span class="font-semibold text-green-600" id="week-sales">$0</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span>Gastos esta semana:</span>
                                        <span class="font-semibold text-red-600" id="week-expenses">$0</span>
                                    </div>
                                    <div class="flex justify-between">
                                        <span>Pedidos esta semana:</span>
