                            <div class="text-2xl font-bold text-red-600">$${dailyExpenses}</div>
                            <div class="text-sm text-gray-600">Gastos</div>
                        </div>
                        <div class="text-center">
                            <div class="text-2xl font-bold text-blue-600">${dailyOrders}</div>
                            <div class="text-sm text-gray-600">Pedidos</div>
                        </div>
                        <div class="text-center">
                            <div class="text-2xl font-bold text-purple-600">$${dailySales - dailyExpenses}</div>
                            <div class="text-sm text-gray-600">Ganancia</div>
                        </div>
                    </div>
                    <div class="text-sm text-gray-600">
                        <p><strong>Estado del local:</strong> ${managementData.storeStatus.open ? 'Abierto' : 'Cerrado'}</p>
