        function loadExpensesData() {
            // Load expense categories summary
            const categoriesContainer = document.getElementById('expense-categories-summary');
            const categories = {
                'sueldos': { name: '💼 Sueldos', total: 0 },
                'insumos': { name: '📦 Insumos', total: 0 },
                'servicios': { name: '⚡ Servicios', total: 0 },
                'mantenimiento': { name: '🔧 Mantenimiento', total: 0 },
                'marketing': { name: '📢 Marketing', total: 0 },
                'otros': { name: '📋 Otros', total: 0 }
            };
            
            // Calculate today's expenses by category
            const today = new Date().toDateString();
            managementData.expenses.forEach(expense => {
                if (expense.timestamp.toDateString() === today) {
                    categories[expense.category].total += expense.amount;
                }
            });
            
            categoriesContainer.innerHTML = '';
            Object.keys(categories).forEach(key => {
                const category = categories[key];
                if (category.total > 0) {
                    const div = document.createElement('div');
                    div.className = 'flex justify-between items-center';
                    div.innerHTML = `
                        <span>${category.name}</span>
                        <span class="font-semibold text-red-600">$${category.total}</span>
                    `;
                    categoriesContainer.appendChild(div);
                }
            });
            
            if (categoriesContainer.innerHTML === '') {
                categoriesContainer.innerHTML = '<p class="text-gray-500 text-center">No hay gastos registrados hoy</p>';
            }
            
            // Load recent expenses
            const recentContainer = document.getElementById('recent-expenses');
            recentContainer.innerHTML = '';
            
            const recentExpenses = managementData.expenses
                .sort((a, b) => b.timestamp - a.timestamp)
                .slice(0, 10);
            
            recentExpenses.forEach(expense => {
                const div = document.createElement('div');
                div.className = 'expense-item bg-white p-3 rounded-lg';
                div.innerHTML = `
                    <div class="flex justify-between items-start">
                        <div class="flex-1">
                            <div class="font-semibold">${expense.description}</div>
                            <div class="text-sm text-gray-600">${categories[expense.category].name} • ${expense.user}</div>
                            <div class="text-xs text-gray-500">${expense.timestamp.toLocaleString()}</div>
                        </div>
                        <div class="text-right">
                            <div class="font-semibold text-red-600">$${expense.amount}</div>
                        </div>
                    </div>
                `;
                recentContainer.appendChild(div);
            });
            
            if (recentExpenses.length === 0) {
                recentContainer.innerHTML = '<p class="text-gray-500 text-center py-4">No hay gastos registrados</p>';
            }
        }

