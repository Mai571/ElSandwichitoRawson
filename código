        function saveOwnerSettings() {
            config.restaurantName = document.getElementById('owner-restaurant-name').value;
            config.whatsappNumber = document.getElementById('owner-whatsapp').value;
            
            // Update header
            document.getElementById('restaurant-name').innerHTML = `<span id="restaurant-logo-before">${config.restaurantLogo}</span> ${config.restaurantName} <span id="restaurant-logo-after">${config.restaurantLogo}</span>`;
            
            alert('Configuración guardada correctamente');
        }

        function toggleManagementPasswordVisibility() {
            const passwordInput = document.getElementById('management-password');
            const toggleIcon = document.getElementById('management-password-toggle-icon');
            
            if (passwordInput.type === 'password') {
                passwordInput.type = 'text';
                toggleIcon.textContent = '🙉';
            } else {
                passwordInput.type = 'password';
                toggleIcon.textContent = '🙈';
            }
        }

        // Main Menu Functions
        function renderCategories() {
            const categoriesContainer = document.getElementById('categories');
            categoriesContainer.innerHTML = '';
            
            Object.keys(categories).forEach(categoryId => {
                const category = categories[categoryId];
                const categoryCard = document.createElement('div');
                categoryCard.className = 'category-card text-white rounded-xl p-4 shadow-lg cursor-pointer border-2 border-transparent glow';
                categoryCard.onclick = () => showCategory(categoryId);
                
                categoryCard.innerHTML = `
                    <div class="text-center">
                        <div class="text-4xl mb-2">${category.emoji}</div>
                        <h3 class="font-semibold">${category.name}</h3>
                    </div>
                `;
                
                categoriesContainer.appendChild(categoryCard);
            });
        }

        function showCategory(category) {
            document.getElementById('categories').classList.add('hidden');
            document.getElementById('products-section').classList.remove('hidden');
            
            document.getElementById('category-title').textContent = `${categories[category].emoji} ${categories[category].name}`;
            
            const productsGrid = document.getElementById('products-grid');
            productsGrid.innerHTML = '';
            
            menuData[category].forEach(product => {
                const productCard = document.createElement('div');
                const isAvailable = product.available !== false && managementData.storeStatus.open;
                
                productCard.className = `product-card text-white rounded-xl p-6 shadow-lg transition-all glow ${
                    isAvailable ? 'cursor-pointer hover:shadow-xl' : 'opacity-60 cursor-not-allowed'
                }`;
                
                if (isAvailable) {
                    productCard.onclick = () => openProductModal(product);
                }
                
                const availabilityBadge = !product.available 
                    ? '<div class="bg-red-100 text-red-800 text-xs px-2 py-1 rounded-full mb-2">AGOTADO</div>'
                    : !managementData.storeStatus.open 
                    ? '<div class="bg-yellow-100 text-yellow-800 text-xs px-2 py-1 rounded-full mb-2">CERRADO</div>'
                    : '';
                
                const productImage = product.image 
                    ? `<img src="${product.image}" alt="${product.name}" class="w-20 h-20 object-cover rounded-full mx-auto mb-3 border-2 border-white">`
                    : `<div class="text-5xl mb-3">${product.emoji}</div>`;
                
                productCard.innerHTML = `
                    <div class="text-center">
                        ${productImage}
                        ${availabilityBadge}
                        <h3 class="font-bold text-lg mb-2">${product.name}</h3>
                        <p class="text-gray-100 text-sm mb-3">${product.description}</p>
                        <div class="text-2xl font-bold text-yellow-300">$${product.price}</div>
                    </div>
                `;
                
                productsGrid.appendChild(productCard);
            });
        }

        function showCategories() {
            document.getElementById('categories').classList.remove('hidden');
            document.getElementById('products-section').classList.add('hidden');
        }

        function openProductModal(product) {
            // Check if store is open
            if (!managementData.storeStatus.open) {
                showClosedModal();
                return;
            }
            
            // Check if product is available
            if (product.available === false) {
                alert('Este producto está agotado temporalmente');
                return;
            }
            
            currentProduct = product;
            selectedAdicionales = [];
            modalQuantity = 1;
            
            document.getElementById('modal-product-name').textContent = product.name;
            document.getElementById('modal-product-description').textContent = product.description;
            document.getElementById('modal-product-price').textContent = `$${product.price}`;
            document.getElementById('modal-quantity').textContent = '1';
            
            // Render adicionales based on product configuration
            const adicionalesList = document.getElementById('adicionales-list');
            adicionalesList.innerHTML = '';
            
            const adicionalesSection = document.getElementById('adicionales-section');
            
            if (product.adicionales && product.adicionales.length > 0) {
                adicionalesSection.classList.remove('hidden');
                
                product.adicionales.forEach(adicionalIndex => {
                    if (adicionales[adicionalIndex]) {
                        const adicional = adicionales[adicionalIndex];
                        const adicionalDiv = document.createElement('div');
                        adicionalDiv.className = 'flex items-center justify-between';
                        adicionalDiv.innerHTML = `
                            <label class="flex items-center cursor-pointer">
                                <input type="checkbox" class="mr-2" onchange="toggleAdicional(${adicionalIndex})">
                                <span>${adicional.name}</span>
                            </label>
                            <span class="text-sm text-gray-600">+$${adicional.price}</span>
                        `;
                        adicionalesList.appendChild(adicionalDiv);
                    }
                });
            } else {
                adicionalesSection.classList.add('hidden');
            }
            
            updateModalTotal();
            const modal = document.getElementById('product-modal');
            modal.classList.remove('hidden');
            modal.querySelector('.bg-white').classList.add('modal-enter');
        }

        function closeProductModal() {
            document.getElementById('product-modal').classList.add('hidden');
        }

        function toggleAdicional(index) {
            const adicional = adicionales[index];
            const existingIndex = selectedAdicionales.findIndex(a => a.name === adicional.name);
            
            if (existingIndex > -1) {
                selectedAdicionales.splice(existingIndex, 1);
            } else {
                selectedAdicionales.push(adicional);
            }
            
            updateModalTotal();
        }

        function changeQuantity(change) {
            modalQuantity = Math.max(1, modalQuantity + change);
            document.getElementById('modal-quantity').textContent = modalQuantity;
            updateModalTotal();
        }

        function updateModalTotal() {
            const basePrice = currentProduct.price;
            const adicionalesPrice = selectedAdicionales.reduce((sum, a) => sum + a.price, 0);
            const total = (basePrice + adicionalesPrice) * modalQuantity;
            document.getElementById('modal-total-price').textContent = `$${total}`;
        }

        function addToCart() {
            const basePrice = currentProduct.price;
            const adicionalesPrice = selectedAdicionales.reduce((sum, a) => sum + a.price, 0);
            const unitPrice = basePrice + adicionalesPrice;
            
            const cartItem = {
                id: Date.now(),
                productId: currentProduct.id,
                name: currentProduct.name,
                basePrice: basePrice,
                adicionales: [...selectedAdicionales],
                quantity: modalQuantity,
                unitPrice: unitPrice,
                totalPrice: unitPrice * modalQuantity
            };
            
            cart.push(cartItem);
            updateCartUI();
            closeProductModal();
            
            // Bounce animation
            document.getElementById('cart-button').classList.add('cart-bounce');
            setTimeout(() => {
                document.getElementById('cart-button').classList.remove('cart-bounce');
            }, 500);
        }

        function updateCartUI() {
            const cartCount = cart.reduce((sum, item) => sum + item.quantity, 0);
            document.getElementById('cart-count').textContent = cartCount;
            
            const cartItems = document.getElementById('cart-items');
            cartItems.innerHTML = '';
            
            if (cart.length === 0) {
                cartItems.innerHTML = '<p class="text-gray-500 text-center py-4">Tu carrito está vacío</p>';
                document.getElementById('checkout-btn').disabled = true;
                document.getElementById('checkout-btn').classList.add('opacity-50');
            } else {
                document.getElementById('checkout-btn').disabled = false;
                document.getElementById('checkout-btn').classList.remove('opacity-50');
                
                cart.forEach(item => {
                    const itemDiv = document.createElement('div');
                    itemDiv.className = 'bg-gray-50 rounded-lg p-3';
                    
                    const adicionalesText = item.adicionales.length > 0 
                        ? `<div class="text-xs text-gray-500">+ ${item.adicionales.map(a => a.name).join(', ')}</div>`
                        : '';
                    
                    itemDiv.innerHTML = `
                        <div class="flex justify-between items-start">
                            <div class="flex-1">
                                <h4 class="font-semibold text-sm">${item.name}</h4>
                                ${adicionalesText}
                                <div class="text-sm text-gray-600">Cantidad: ${item.quantity}</div>
                            </div>
                            <div class="text-right">
                                <div class="font-semibold text-red-500">$${item.totalPrice}</div>
                                <button onclick="removeFromCart(${item.id})" class="text-red-500 hover:text-red-700 text-sm">Eliminar</button>
                            </div>
                        </div>
                    `;
                    
                    cartItems.appendChild(itemDiv);
                });
            }
            
            const total = cart.reduce((sum, item) => sum + item.totalPrice, 0);
            document.getElementById('cart-total').textContent = `$${total}`;
        }

        function removeFromCart(itemId) {
            cart = cart.filter(item => item.id !== itemId);
            updateCartUI();
        }

        function toggleCart() {
            document.getElementById('cart-modal').classList.toggle('hidden');
        }

        function showCheckout() {
            if (cart.length === 0) return;
            
            // Check if store is still open
            if (!managementData.storeStatus.open) {
                document.getElementById('cart-modal').classList.add('hidden');
                showClosedModal();
                return;
            }
            
            document.getElementById('cart-modal').classList.add('hidden');
            document.getElementById('checkout-modal').classList.remove('hidden');
        }

        function closeCheckout() {
            document.getElementById('checkout-modal').classList.add('hidden');
        }

        function toggleDeliveryForm() {
            const deliveryType = document.querySelector('input[name="delivery"]:checked')?.value;
            
            document.getElementById('pickup-form').classList.add('hidden');
            document.getElementById('delivery-form').classList.add('hidden');
            
            if (deliveryType === 'pickup') {
                document.getElementById('pickup-form').classList.remove('hidden');
            } else if (deliveryType === 'delivery') {
                document.getElementById('delivery-form').classList.remove('hidden');
            }
        }

        function sendToWhatsApp() {
            const deliveryType = document.querySelector('input[name="delivery"]:checked')?.value;
            
            if (!deliveryType) {
                alert('Por favor selecciona el tipo de entrega');
                return;
            }
            
            let customerInfo = '';
            
            if (deliveryType === 'pickup') {
                const name = document.getElementById('pickup-name').value.trim();
                const phone = document.getElementById('pickup-phone').value.trim();
                
                if (!name || !phone) {
                    alert('Por favor completa todos los campos obligatorios');
                    return;
                }
                
                customerInfo = `*RETIRO EN LOCAL*\nNombre: ${name}\nTeléfono: ${phone}`;
            } else {
                const name = document.getElementById('delivery-name').value.trim();
                const street = document.getElementById('delivery-street').value.trim();
                const number = document.getElementById('delivery-number').value.trim();
                const neighborhood = document.getElementById('delivery-neighborhood').value.trim();
                const phone = document.getElementById('delivery-phone').value.trim();
                
                if (!name || !street || !number || !neighborhood || !phone) {
                    alert('Por favor completa todos los campos obligatorios');
                    return;
                }
                
                customerInfo = `*ENVÍO A DOMICILIO*\nNombre: ${name}\nDirección: ${street} ${number}, ${neighborhood}\nCelular: ${phone}`;
            }
            
            // Generate order message
            let orderMessage = config.whatsappMessage.replace('{RESTAURANT_NAME}', config.restaurantName) + '\n\n';
            orderMessage += `${customerInfo}\n\n`;
            orderMessage += `*PRODUCTOS:*\n`;
            
            cart.forEach(item => {
                orderMessage += `• ${item.name} x${item.quantity} - $${item.totalPrice}\n`;
                if (item.adicionales.length > 0) {
                    orderMessage += `  Adicionales: ${item.adicionales.map(a => a.name).join(', ')}\n`;
                }
            });
            
            const total = cart.reduce((sum, item) => sum + item.totalPrice, 0);
            orderMessage += `\n*TOTAL: $${total}*`;
            
            const whatsappURL = `https://wa.me/${config.whatsappNumber}?text=${encodeURIComponent(orderMessage)}`;
            
            window.open(whatsappURL, '_blank');
            
            // Update sales stats
            managementData.dailyStats.sales += total;
            managementData.dailyStats.orders += 1;
            managementData.dailyStats.profit = managementData.dailyStats.sales - managementData.dailyStats.expenses;
            
            // Update cash if open
            if (managementData.cashStatus.open) {
                managementData.cashStatus.sales += total;
            }
            
            // Reset cart and close modal
            cart = [];
            updateCartUI();
            closeCheckout();
            alert('¡Pedido enviado! Te redirigimos a WhatsApp para confirmar tu orden.');
        }

        function showClosedModal() {
            const scheduleDiv = document.getElementById('current-schedule');
            scheduleDiv.innerHTML = `
                <div class="text-center">
                    <strong>¡Disculpas!</strong><br><br>
                    El local está temporalmente cerrado.<br><br>
                    <strong>Por favor intenta más tarde</strong>
                </div>
            `;
            
            document.getElementById('closed-modal').classList.remove('hidden');
        }
        
        function closeClosedModal() {
            document.getElementById('closed-modal').classList.add('hidden');
        }

        // Initialize
        renderCategories();
        updateCartUI();
        
        // Initialize store status display
        updateStoreStatusDisplay();
    </script>
