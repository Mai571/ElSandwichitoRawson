        function addEmployee() {
            const name = document.getElementById('employee-name').value.trim();
            const username = document.getElementById('employee-username').value.trim();
            const password = document.getElementById('employee-password').value.trim();
            const role = document.getElementById('employee-role').value;
            
            if (!name || !username || !password) {
                alert('Por favor completa todos los campos');
                return;
            }
            
            if (managementData.users[username]) {
                alert('Ya existe un usuario con ese nombre');
                return;
            }
            
            managementData.users[username] = {
                password: password,
                role: role,
                name: name
            };
            
            // Clear form
            document.getElementById('employee-name').value = '';
            document.getElementById('employee-username').value = '';
            document.getElementById('employee-password').value = '';
            document.getElementById('employee-role').value = 'manager';
            updatePermissionsPreview();
            
            loadOwnerData();
            alert('Empleado agregado correctamente');
        }

        function removeEmployee(username) {
            if (confirm(`¿Estás seguro de eliminar al empleado ${managementData.users[username].name}?`)) {
                delete managementData.users[username];
                loadOwnerData();
                alert('Empleado eliminado correctamente');
            }
        }

